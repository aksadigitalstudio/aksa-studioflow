{
  "name": "aksa-studioflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4300 --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "node server.mjs",
    "start": "npm run build && npm run preview",
    "test:ui": "node tests/workflow.mjs",
    "test:domain": "node tests/domain.mjs",
    "test:database": "node tests/database.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "playwright": "^1.63.0",
    "@electric-sql/pglite": "^0.5.8"
  }
}
